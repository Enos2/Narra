{
  "name": "backend",
  "version": "1.0.0",
  "description": "Narra Video Streaming Platform Backend with Live Streaming",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "install-deps": "npm install",
    "install-streaming-deps": "npm install node-media-server ffmpeg-static ws",
    "check-ffmpeg": "ffmpeg -version",
    "streaming-server": "node streaming-server.js"
  },
  "keywords": [
    "video-streaming",
    "live-streaming",
    "media-server",
    "rtmp",
    "hls",
    "video-platform",
    "content-upload",
    "admin-dashboard"
  ],
  "author": "Narra Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.9",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-media-server": "^4.2.4",
    "path": "^0.12.7",
    "sharp": "^0.34.5",
    "socket.io": "^4.2.0",
    "socket.io-client": "^4.2.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": "18.x",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/narra-backend.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/narra-backend/issues"
  },
  "homepage": "https://github.com/yourusername/narra-backend#readme",
  "files": [
    "server.js",
    "streaming-server.js",
    "controllers/",
    "models/",
    "routes/",
    "middleware/",
    "uploads/",
    "media/",
    ".env.example"
  ],
  "directories": {
    "controller": "controllers",
    "model": "models",
    "route": "routes",
    "middleware": "middleware"
  },
  "config": {
    "port": 5000,
    "rtmp_port": 1935,
    "hls_port": 8000
  }
