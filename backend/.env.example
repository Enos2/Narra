# ─────────────────────────────────────────────────────────────
# File: backend/.env.example
# Purpose: Template of every environment variable the backend reads.
#          Copy to .env locally; set the same keys in Render for production.
#          NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000
# Render uses NODE_VERSION; package.json "engines" requires Node 20.
NODE_VERSION=20.18.0

# Main frontend URL (CORS + links). Extra allowed origins: comma-separated.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the API (Render = 1). Needed so
# rate limiting sees the real client IP. Leave empty for the default
# (1 in production, off in development).
TRUST_PROXY=

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=
MONGO_URI=

# ── Auth ─────────────────────────────────────────────────────
# Use a long random value (32+ characters), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime (default 7d). Shorter is safer; "Logout all devices" and
# password reset revoke every existing token immediately.
JWT_EXPIRES_IN=7d
FOUNDER_ADMIN_EMAIL=

# ── E-mail (password reset + "password changed" notice) ──────
# Any SMTP provider works (Gmail app password, Brevo, Mailgun, SendGrid, Zoho…).
# Without these, reset e-mails are NOT sent (the link is only printed to the
# console when NODE_ENV is not production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Narra <no-reply@yourdomain.com>
# Frontend page that receives the token. Default: FRONTEND_URL + /reset-password
PASSWORD_RESET_URL_BASE=

# ── Admin seeding (node seed/seedAdmins.js) — leave passwords empty to have a
#    strong random one generated and printed once ─────────────
# SEED_SUPERADMIN_EMAIL=
# SEED_SUPERADMIN_USERNAME=superadmin
# SEED_SUPERADMIN_PASSWORD=

# ── Wallet & M-Pesa top-ups ──────────────────────────────────
# Public https URL of THIS API (Safaricom must be able to reach the callback).
API_PUBLIC_URL=
# Wallet currency. LEAVE EMPTY to keep the old behaviour (a video's price is
# compared with the balance as a plain number). If you set it (e.g. KES), every
# paid video priced in another currency needs a rate, otherwise it cannot be
# bought. Videos default to "USD", so set a rate such as:  FX_RATES={"USD":129}
WALLET_CURRENCY=
FX_RATES=
PLATFORM_FEE_PERCENT=20
TOPUP_MIN=10
TOPUP_MAX=150000

# Safaricom Daraja — https://developer.safaricom.co.ke (start with sandbox!)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill, default) or CustomerBuyGoodsOnline (till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For a till number put the till here; defaults to MPESA_SHORTCODE
MPESA_PARTY_B=
# Long random string (24+ chars). It becomes part of the callback URL that only
# Safaricom knows:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_SECRET=
# Optional: comma-separated Safaricom callback IPs to allow (extra protection)
MPESA_CALLBACK_IPS=

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Live streaming ───────────────────────────────────────────
ENABLE_STREAMING=true
# Public base URL viewers use to fetch HLS  (…/live/<playbackId>/index.m3u8)
HLS_SERVER_URL=http://localhost:5000
# RTMP ingest URL shown to hosts for OBS (the stream key is appended)
RTMP_SERVER_URL=rtmp://localhost:1935/live
RTMP_PORT=1935
# Temporary compatibility for the old frontend's host preview. Set to false
# once the new frontend reads playbackId / hlsUrl.
LEGACY_HOST_HLS_ALIAS=true
# FFMPEG_PATH=/usr/bin/ffmpeg   # only if ffmpeg-static is unavailable
# ── Uploads ──────────────────────────────────────────────────
# Largest video accepted when uploaded THROUGH this server (multipart). It is
# written to a temp file, so make sure the server has that much free disk.
# Bigger files should use the direct-to-Cloudinary flow (POST /api/uploads/sign
# then /api/uploads/video/finalize), which has no limit imposed by this server —
# only by your Cloudinary plan and the per-account quotas in uploadController.js.
MAX_VIDEO_UPLOAD_MB=2000
# UPLOAD_TMP_DIR=/tmp/narra-uploads